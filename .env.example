# Server
PORT=3000
NODE_ENV=development

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://imgrel:imgrel@localhost:5434/imagerelevance

# Gemini (get a free key at https://aistudio.google.com — no credit card)
GEMINI_API_KEY=your-gemini-api-key-here

# Vision model settings
VISION_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Mismatch guard thresholds (tune these with your eval set)
# Cosine similarity below this → "no confident match"
SIMILARITY_THRESHOLD=0.72
# Vision confidence below this → flagged for review instead of accepted
CONFIDENCE_THRESHOLD=0.70

# Cost tracking budget guard (USD) — stops the batch job if exceeded
COST_BUDGET_USD=1.00

# Batch job settings
INGEST_BATCH_SIZE=5
INGEST_RETRY_MAX=3
