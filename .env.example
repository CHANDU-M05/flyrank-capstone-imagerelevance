# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database (matches docker-compose.yml defaults; host port 5434) ----
DATABASE_URL=postgres://imgrel:imgrel@localhost:5434/imagerelevance

# ---- Gemini (free key at https://aistudio.google.com — no credit card) ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ---- Cost tracking: paid-tier per-1M-token USD rates (operator-configurable
#      estimates). On the free tier the real invoice is $0.00 but we still accrue
#      at these rates so accounting + the budget guard are observable. ----
VISION_PRICING_USD_PER_M_INPUT=0.30
VISION_PRICING_USD_PER_M_OUTPUT=2.50
EMBEDDING_PRICING_USD_PER_M=0.15
# Budget guard (USD) — stops new paid work before the request if it would exceed.
COST_BUDGET_USD=1.00
# Conservative token projection for one image request, used for pre-send budget check.
MAX_IMAGE_TOKENS=20000

# ---- Mismatch guard thresholds (tune with your eval set, then defend the number) ----
# Cosine similarity below this -> "no confident match".
SIMILARITY_THRESHOLD=0.72
# Vision confidence below this -> flagged for review instead of accepted.
CONFIDENCE_THRESHOLD=0.70
# Vision confidence below this AND unsupported by caption/attributes -> hard reject.
GUARD_CONFIDENCE_REJECT=0.40
# How many ranked candidates the guard evaluates per post.
TOP_K=8

# ---- Batch job settings ----
INGEST_BATCH_SIZE=5
INGEST_RETRY_MAX=3
REQUEST_TIMEOUT_MS=60000
RETRY_BASE_DELAY_MS=1000

# ---- Notifications (optional webhook; falls back to sanitized console) ----
NOTIFY_WEBHOOK_URL=
